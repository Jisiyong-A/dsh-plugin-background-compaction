{
  "name": "dsh-plugin-background-compaction",
  "version": "2.0.1",
  "type": "module",
  "description": "Speculative background compaction for DeepSeek Harness: precompute the summary at 72% of pressure, serve it instantly when compaction fires.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "compaction",
    "context-window",
    "speculative",
    "compaction-engine"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "tsc --noEmit && node scripts/build.mjs && node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
